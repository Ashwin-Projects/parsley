# Copy to .env to use --mode llm or --mode hybrid. The default mode (rules) never reads this.
# Real environment variables win over this file. Never commit your .env.

# anthropic | openai (any OpenAI-compatible server) | fake (replays a fixtures file)
PARSLEY_LLM_PROVIDER=anthropic

# Optional for anthropic (default claude-opus-5-5); required for openai.
# PARSLEY_LLM_MODEL=claude-opus-5-5

# Optional. Examples for openai:
#   OpenAI  https://api.openai.com/v1 (the default)
#   Groq    https://api.groq.com/openai/v1
#   Ollama  http://localhost:11434/v1 (no key needed)
# PARSLEY_LLM_BASE_URL=

# Seconds per attempt (default 20). A failed call is retried once.
# PARSLEY_LLM_TIMEOUT=20

# The key for your provider. PARSLEY_LLM_API_KEY wins over the vendor names.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# PARSLEY_LLM_API_KEY=

# Only for PARSLEY_LLM_PROVIDER=fake.
# PARSLEY_LLM_FIXTURES=tests/fixtures_llm/recorded.json
